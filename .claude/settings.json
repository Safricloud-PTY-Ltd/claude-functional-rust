{
  "agent": "orchestrator",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "300",
    "CODEX_ALLOWED_MODELS": "gpt-6-astra",
    "CODEX_TEST_WRITER_MODEL": "gpt-6-astra",
    "CODEX_TEST_WRITER_EFFORT": "medium",
    "CODEX_TEST_WRITER_SPEED": "base",
    "CODEX_IMPLEMENTOR_MODEL": "gpt-6-astra",
    "CODEX_IMPLEMENTOR_EFFORT": "medium",
    "CODEX_IMPLEMENTOR_SPEED": "base",
    "CODEX_REVIEW_MODEL": "gpt-6-astra",
    "CODEX_REVIEW_EFFORT": "medium",
    "CODEX_REVIEW_SPEED": "base",
    "CLAUDE_REVIEW_MODEL": "opus",
    "CLAUDE_REVIEW_EFFORT": "high"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-writes.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-file.sh\"",
            "timeout": 180,
            "statusMessage": "rustfmt · clippy · related tests"
          }
        ]
      }
    ]
  }
}
